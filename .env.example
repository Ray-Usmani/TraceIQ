# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=traceiq
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Database roles (created by database/roles.sql and scripts/ingest_data.py)
ANALYTICS_ADMIN_PASSWORD=admin_password
ANALYTICS_READER_PASSWORD=reader_password

# OpenRouter (OpenAI-compatible)
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MODEL=minimax/minimax-m3:free
# Optional: force JSON object mode (not all models support it)
LLM_JSON_MODE=false

# LangSmith tracing (optional — leave LANGCHAIN_API_KEY empty to disable)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=TraceIQ

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Phase 3 in-memory investigation limits
ANALYSIS_MAX_STEPS=8
ANALYSIS_MAX_ACTIVE_RUNS=4
ANALYSIS_RUN_CACHE_SIZE=100
STRUCTURED_OUTPUT_MAX_ATTEMPTS=2

# Frontend
VITE_API_URL=http://localhost:8000
